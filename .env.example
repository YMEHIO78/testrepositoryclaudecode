# Copy to .env for local dev. In Railway, set these under Variables instead —
# never commit a real .env file.

PORT=3000

# Postgres connection string. On Railway this is set automatically via a
# reference variable (${{ Postgres.DATABASE_URL }}) once a Postgres
# service is attached — for local dev, point it at your own database.
DATABASE_URL=

# Login form credentials (server.js: GET/POST /login). Set real values
# in Railway's Variables tab — the app has no way to log in if unset.
AUTH_USER=
AUTH_PASS=

# Signs the session cookie — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used to encrypt stored OAuth tokens at rest (oauth_tokens table) —
# generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Comma-separated allowlist of mailboxes the app may connect,
# e.g. clientcare@yourdomain.com,admin@yourdomain.com
MAILBOXES=

# Mail server defaults, pre-filled in the connect form (per-mailbox
# overrides are possible in the UI). Defaults target Hostinger.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465

# Wave accounting full access token. Optional - it can also be pasted in
# the app under Integrations, which stores it encrypted. A full access
# token reads your own business without Wave's paid tier; OAuth would
# require it.
WAVE_TOKEN=
WAVE_BUSINESS_ID=

# Calendly personal access token. Optional — it can also be pasted in the
# app under Integrations, which stores it encrypted. Setting it here takes
# precedence and keeps it out of the browser entirely.
CALENDLY_TOKEN=

# How often to poll Calendly for new/cancelled bookings, in minutes.
CALENDLY_POLL_MINUTES=5

# Google Cloud OAuth client (Calendar API). This bridge exists so Calendly
# can see events created in this app: Calendly checks its connected
# calendars for conflicts and cannot read our .ics feed, so events are
# mirrored into Google for it to find.
# Authorized redirect URI: https://<your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# File storage (S3-compatible; Railway Buckets provide these as
# reference variables). Uploads are disabled if unset.
FILES_BUCKET=
FILES_ACCESS_KEY_ID=
FILES_SECRET_ACCESS_KEY=
FILES_REGION=
FILES_ENDPOINT=
# Per-file upload cap in bytes (default 25MB).
FILES_MAX_BYTES=

# AI assistant (Assistant view). Without this the view says so and the
# chat is disabled; nothing else in the app depends on it.
# Note that enabling it sends the records the assistant reads — client
# names, ticket text, meeting titles — to Anthropic's API.
ANTHROPIC_API_KEY=
