# Copy to .env for local dev. In Railway, set these under Variables instead —
# never commit a real .env file.

PORT=3000

# Basic auth gate in front of the whole app (server.js). Set real values
# in Railway's Variables tab — the app runs with no login if unset.
AUTH_USER=
AUTH_PASS=

# Microsoft Entra app registration (Outlook mail + Outlook Calendar via Graph)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# Wave API
WAVE_CLIENT_ID=
WAVE_CLIENT_SECRET=

# Used to encrypt stored OAuth tokens at rest — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Session/auth secret for your login layer
SESSION_SECRET=
